{
  "name": "livrago",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @livrago/api",
    "dev:api": "npm run dev --workspace @livrago/api",
    "dev:mobile": "npm run start --workspace @livrago/mobile",
    "build": "npm run build --workspace @livrago/shared-types && npm run build --workspace @livrago/validation && npm run build --workspace @livrago/config && npm run build --workspace @livrago/api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
